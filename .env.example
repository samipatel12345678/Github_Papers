# Server Configuration
PORT=5000

# MongoDB Connection String (leave as default or provide MongoDB Atlas URI)
# If MongoDB is not running, the app automatically switches to Resilient In-Memory Mode!
MONGODB_URI=mongodb://127.0.0.1:27017/multi_coding_agents

# LLM Providers (Optional - default is built-in intelligent Mock mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
